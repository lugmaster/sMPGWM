<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep the custom Godot packages separate from the stock packages of the same version. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="GodotSteam" value="%USERPROFILE%/godot_engine/Godot_v4.6.2_mono_steam/editor/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="GodotSteam">
      <package pattern="Godot.*" />
      <package pattern="GodotSharp*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
